# Copie ce fichier en ".env" et remplis ta vraie clé.
#   cp .env.example .env
# Puis colle ta clé OpenAI (commence par sk-...). Le fichier .env est ignoré par git.

OPENAI_API_KEY=sk-your-key-here

# Modèle utilisé pour rédiger lettres de motivation / réponses aux questions ouvertes.
OPENAI_MODEL=gpt-4o-mini

# true = navigateur visible (obligatoire pour le mode semi-auto où tu valides avant d'envoyer)
# false = navigateur invisible (headless) — à réserver plus tard au full-auto
HEADED=true

# --- Découverte : agrégateurs à clé API (gratuites) --------------------------
# ADZUNA = la meilleure couverture "toutes les entreprises" par ville/pays.
#   Crée un compte gratuit -> https://developer.adzuna.com/  -> copie app_id + app_key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# The Muse marche SANS clé (débit limité). Clé gratuite optionnelle -> themuse.com/developers
THEMUSE_API_KEY=
